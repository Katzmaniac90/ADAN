[node name="npc1" parent="." unique_id=1646254127 instance=ExtResource("15_nfd2q")]
position = Vector2(420, 377)
npc_name = "Gary the Guide"
dialogue_text = "Hello there! I'm the first NPC ever created! Wow... actually kinda weird to think about... Anyway! I'm here to provide some basic controls for your journey into ADAN!

[E] - Interact with stuff
[T] - Equipment Page
[B] - Bag / Inventory
[K] - Skills Page
[Y] - Achievements

Now I know the sign over there tells you the same thing, but I mean come on... let's be honest... signs are dumb! They can't even move! Look at me, I can actually wander around like a REAL person!! 

Okay.. maybe I'm being too harsh... Signs are okay for some stuff, but don't hesitate to speak with people that look like me, they'll tell you some really cool stuff! "
wander_radius_blocks = 2.0

