[node name="npc1" parent="." unique_id=1646254127 instance=ExtResource("26_5w68m")]
position = Vector2(320, 992)
npc_name = "Amy the Adventurous"
dialogue_text = "Well hi there! Always fun to see new faces in the forest :)

Take care not to get lost though, it can be pretty easy to get caught up in the trees, especially just south of Skytree Village. The woods down there are as dense as any I've ever seen! I almost couldn't find a way back out myself.. 

I did stumble upon a cool looking path towards the back of the woods, but there was a big tree in the way and I couldn't get through :/  I wonder what's back there..."
wander_radius_blocks = 8.0
tile_size = 16.0

