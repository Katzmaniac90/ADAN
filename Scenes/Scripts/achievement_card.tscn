[sub_resource type="GDScript" id="GDScript_t4rsj"]
script/source = "extends Control

@onready var panel = self
@onready var name_label = $NameLabel
@onready var description_label = $DescriptionLabel
@onready var progress_label = $ProgressLabel
@onready var lock_icon = $LockIcon

func setup_achievement(name, description, unlocked):

	name_label.text = name
	description_label.text = description

	var style = panel.get_theme_stylebox(\"panel\").duplicate()

	if unlocked:

		lock_icon.hide()

		style.bg_color = Color(0.35, 0.85, 0.35)
		style.border_color = Color(0.15, 0.45, 0.15)

		panel.add_theme_stylebox_override(\"panel\", style)

		name_label.modulate = Color.BLACK
		description_label.modulate = Color.BLACK

	else:

		lock_icon.show()

		panel.add_theme_stylebox_override(\"panel\", style)

		name_label.modulate = Color.WHITE
		description_label.modulate = Color.WHITE
"

